def marked_existing_paths() -> None:
    plan = text("docs/03-technical-plan.md")
    missing: list[str] = []
    for path in re.findall(r"\|\s*`([^`]+)`\s*\|\s*\[E\]", plan):
        if "/" in path and " / " in path:
            continue
        if not (REPO / path).exists():
            missing.append(path)
    check("[E] code map", not missing, "all paths exist" if not missing else ", ".join(missing))


def suppressions() -> None:
    patterns = ("eslint-disable", "phpcs:ignore", "@SuppressWarnings", "# noqa", "NOLINT")
    count = 0
    for root in ("include", "src", "test"):
        for path in (REPO / root).rglob("*"):
            if path.is_file():
                body = path.read_text(encoding="utf-8", errors="ignore")
                count += sum(body.count(pattern) for pattern in patterns)
    check("Suppressions", count == 0, f"count={count}")


def git_repository() -> None:
    result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        cwd=REPO,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )
    check(
        "Git repository",
        result.returncode == 0 and Path(result.stdout.strip()).resolve() == REPO,
        result.stdout.strip() or "invalid",
    )


def public_repository_structure() -> None:
    english = text("README.md")
    spanish = text("README.es.md")
    reciprocal = "[Español](README.es.md)" in english and "[English](README.md)" in spanish

    tracked_result = subprocess.run(
        ["git", "ls-files"],
        cwd=REPO,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )
    tracked = tracked_result.stdout.splitlines() if tracked_result.returncode == 0 else []
    forbidden_roots = ("build/", "managed_components/", ".pio/", ".artifacts/")
    forbidden = [
        path
        for path in tracked
        if path == "sdkconfig"
        or path.startswith(forbidden_roots)
        or "GOLDEN_VERSION" in path.upper()
        or path in {"diagram.json", "wokwi.toml"}
        or path.startswith("lib/")
    ]

    identifier_result = subprocess.run(
        ["git", "grep", "-n", "-I", "-E", r"([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}"],
        cwd=REPO,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )
    identifiers = identifier_result.stdout.splitlines() if identifier_result.returncode == 0 else []

    check("Bilingual public entry", reciprocal, "reciprocal English/Spanish README navigation")
    check(
        "Publishable tracked tree",
        not forbidden and not identifiers,
        "no golden/simulator/vendor/generated paths or exact MAC-like identifiers"
        if not forbidden and not identifiers
        else f"forbidden={forbidden[:8]}; identifiers={identifiers[:4]}",
    )


def interactive_demo_entry() -> None:
    url = "https://kytos22.github.io/esp32-s3-civic-oil-gauge/design/references/oil-gauge-design.html"
    english = text("README.md")
    spanish = text("README.es.md")
    simulator = text("docs/design/references/oil-gauge-design.html")
    generator = text("scripts/generate-readme-demo-gif.py")
    required_ids = ("ogrPressureInput", "ogrRpmInput", "ogrTemperatureInput")
    gif_path = "assets/oil-gauge-demo.gif"
    linked = english.count(url) >= 2 and spanish.count(url) >= 2
    animated = gif_path in english and gif_path in spanish
    controls = all(f'id=&quot;{control_id}&quot;' in simulator for control_id in required_ids)
    listeners = "input.addEventListener(&#x27;input&#x27;, update)" in simulator
    fluid = "FPS = 50" in generator and "smoothstep" in generator and "TRANSITION_FRAMES" in generator
    check(
        "Interactive README entry",
        linked and animated and controls and listeners and fluid,
        "bilingual 50 FPS GIF/live links and three slider listeners present"
        if linked and animated and controls and listeners and fluid
        else f"linked={linked}; animated={animated}; controls={controls}; listeners={listeners}; fluid={fluid}",
    )


def project_license() -> None:
    license_text = text("LICENSE.md")
    notice = text("NOTICE").strip()
    english = text("README.md")
    spanish = text("README.es.md")
    title = "PolyForm Noncommercial License 1.0.0"
    official_url = "https://polyformproject.org/licenses/noncommercial/1.0.0"
    required_notice = "Required Notice: Copyright 2026 Marcos Vidal"
    official_sha256 = "c0ea4a896d2c8c394b29f9427589996db826cd501c512279ff0ed3ef48fabbe5"
    license_sha256 = hashlib.sha256((REPO / "LICENSE.md").read_bytes()).hexdigest()
    terms = (
        license_sha256 == official_sha256
        and title in license_text
        and official_url in license_text
        and "## Changes and New Works License" in license_text
        and "Any noncommercial purpose is a permitted purpose." in license_text
        and notice == required_notice
    )
    summaries = (
        "[PolyForm Noncommercial License 1.0.0](LICENSE.md)" in english
        and "Commercial use is not permitted" in english
        and "[licencia PolyForm Noncommercial 1.0.0](LICENSE.md)" in spanish
        and "El uso comercial requiere" in spanish
    )
    check(
        "Noncommercial project license",
        terms and summaries,
        "official byte-matched terms, required notice and bilingual summaries present"
        if terms and summaries
        else f"terms={terms}; summaries={summaries}; sha256={license_sha256}",
    )


def main() -> int:
    git_repository()
    public_repository_structure()
    interactive_demo_entry()
    project_license()
    required_paths()
    conformance()
    acceptance_coverage()
    local_links()
    cited_commands()
    orphan_documents()
    code_fences()
    safety_invariants()
    approved_geometry()
    bar_decimal_glyph_contract()
    temperature_units_contract()
    warning_animation_contract()
    settings_menu_contract()
    full_frame_and_warning_loop_contract()
    sprint6_physical_revision_contract()
    marked_existing_paths()
    suppressions()
    print(f"VERDICT: {'PASS' if not FAILURES else 'FAIL'}")
    return 0 if not FAILURES else 1


if __name__ == "__main__":
    raise SystemExit(main())
