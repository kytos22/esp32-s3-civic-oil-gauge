    ui = text("docs/UI_DESIGN.md")
    renderer = text("src/oil_gauge_ui.cpp")
    fragment = text("docs/design/references/oil-gauge-design.fragment.html")
    conditions = [
        "480×480" in ui,
        "50/50" in ui,
        "9 px" in ui,
        "--ogr-yellow: #ffb020" in fragment.lower(),
        "--ogr-danger: #ff3948" in fragment.lower(),
        "height: 9px" in fragment,
        'id="ogrRpmInput"' in fragment,
        "createSolid(icon, 31, 0, 10, 42, 5)" in renderer,
        "createSolid(icon, 42, 27, 18, 6, 1)" in renderer,
        'x="36" y="0" width="12" height="48"' in fragment,
        'x="49" y="32" width="21" height="7"' in fragment,
    ]
    check("Approved reference geometry", all(conditions), f"{sum(conditions)}/{len(conditions)} invariants")


